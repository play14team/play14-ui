# Production Environment Variables
# Copy this file to .env.production and fill in your production values

# Backend API
STRAPI_API_URL=https://community.play14.org
STRAPI_API_SECRET=your-production-strapi-api-secret

# Map Integration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-production-mapbox-token

# Web Vitals Reporting
NEXT_PUBLIC_WEB_VITALS=true

# Node Environment (automatically set by container)
# NODE_ENV=production
