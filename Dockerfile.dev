# Multi-stage development Dockerfile with dependency caching
# Dependencies are cached in a separate stage and only rebuilt when package files change

# Stage 1: Dependencies
FROM oven/bun:1.3.5-alpine AS deps
WORKDIR /app

# Copy only package files for dependency installation
COPY package.json bun.lock ./

# Install dependencies with frozen lockfile
# This layer is cached and only rebuilds when package.json or bun.lock changes
RUN bun install --frozen-lockfile

# Stage 2: Development
FROM oven/bun:1.3.5-alpine AS development

WORKDIR /app

# Copy installed dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy package files
COPY package.json bun.lock ./

# Copy application files
# Note: Source files will be mounted as volumes for hot reload
COPY . .

# Expose port 3000
EXPOSE 3000

# Start development server with Turbopack
CMD ["bun", "run", "develop"]
