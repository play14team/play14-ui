    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "purify-css": "^1.2.5",
    "sass": "^1.97.1",
    "typescript": "^5.9.3"
