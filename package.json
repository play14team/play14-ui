    "country-locale-map": "^1.9.11",
    "html-react-parser": "^5.2.11",
    "ics": "^3.8.1",
    "keyv": "^5.5.5",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.17.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "next": "16.0.8",
    "next-safe-action": "^8.0.11",
    "next-themes": "^0.4.6",
    "qs": "^6.14.0",
    "react": "19.2.1",
    "react-audio-player": "^0.17.0",
    "react-big-calendar": "^1.19.4",
    "react-collapsed": "^4.2.0",
